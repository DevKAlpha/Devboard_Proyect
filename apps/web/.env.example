# Base path the app is served from. GitHub Pages: /<repo-name>/  Docker: /
VITE_BASE=/

# Optional. When set, boards are stored through apps/api instead of IndexedDB.
# VITE_API_URL=http://localhost:3000

# Optional. OAuth client ids (public, not secrets) for the Conexiones panel.
# Without them Google/Microsoft show as "Sin configurar". See docs/integraciones.md.
# VITE_GOOGLE_CLIENT_ID=
# VITE_MS_CLIENT_ID=

# Optional. URL of apps/api for GitHub Projects sync (docs/github.md).
# VITE_GITHUB_API_URL=http://localhost:3000
